{
  "name": "@computational-biology-aachen/design",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "watch": "svelte-kit sync && svelte-package --watch",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint ."
  },
  "files": [
    "dist",
    "src/lib",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "types": "./src/lib/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/lib/tokens.css",
    "./*.svelte": {
      "types": "./src/lib/*.svelte",
      "svelte": "./src/lib/*.svelte",
      "default": "./src/lib/*.svelte"
    }
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.23.0",
    "@fortawesome/free-brands-svg-icons": ">=7.3.1",
    "@fortawesome/free-solid-svg-icons": ">=7.3.1",
    "svelte-fa": ">=4.0.4",
    "katex": "^0.18.0",
    "chart.js": ">=4"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/kit": "^2.70.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": ">=10.0.0",
    "@sveltejs/adapter-static": ">=3",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "eslint": ">=10.9.0",
    "eslint-config-prettier": ">=10.0.0",
    "eslint-plugin-svelte": ">=3.20.0",
    "publint": "^0.3.24",
    "prettier": ">=3.9.5",
    "prettier-plugin-css-order": ">=2.2.0",
    "prettier-plugin-svelte": ">=4.1.1",
    "svelte": ">=5.56.10",
    "svelte-check": "^4.7.4",
    "typescript": ">=6.0.0",
    "typescript-eslint": ">=8.62.1",
    "vite": "^8.2.2"
  },
  "keywords": [
    "svelte"
  ]
}
